# ============================================================
# 环境变量样例 —— 复制成 .env 后填真实值。
#
# 这个文件里**不允许出现任何真实密钥**，只放占位符。
# .env 已被 .gitignore 忽略；.env.example 是要提交的。
# ============================================================


# ------------------------------------------------------------
# LLM（DeepSeek）
#
# 全部从环境变量读取，代码里没有任何硬编码密钥。
# ------------------------------------------------------------

LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat


# ------------------------------------------------------------
# PostgreSQL
#
# 本机运行 FastAPI 时使用 127.0.0.1；Compose 中 backend 会覆盖为
# postgres 服务名。数据库结构由 Alembic 管理，应用不会 create_all()。
# ------------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/enterprise_multi_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30

POSTGRES_DB=enterprise_multi_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# ------------------------------------------------------------
# 运行模式
#
# dev  = 本地开发：无鉴权、开 Swagger、连 MCP。默认值。
# demo = 公网演示：要鉴权、关文档、不启动 MCP、
#        限流 / 并发 / token 预算全部生效。
#
# 不设这一项 = dev。部署到公网时务必显式设置。
# ------------------------------------------------------------

APP_MODE=dev


# ------------------------------------------------------------
# 演示模式鉴权（APP_MODE=demo 时必填）
#
# 格式：name:key,name:key
# 每人一把 key，服务端按 name 给会话做命名空间隔离，
# 所以 alice 拿到 bob 的 session_id 也读不到 bob 的数据。
#
# 注意：
#   - name 里不能有冒号
#   - APP_MODE=demo 而这里为空 -> 服务**拒绝启动**
#     （宁可起不来，也不要"以为有保护其实没有"）
#   - key 不要用可猜的词，用随机串
# ------------------------------------------------------------

DEMO_API_KEYS=alice:replace-with-random-string,bob:replace-with-random-string


# ------------------------------------------------------------
# 演示模式限额
# ------------------------------------------------------------

# 每个 principal 每分钟的请求数上限；<=0 关闭限流
DEMO_RATE_LIMIT_PER_MINUTE=10

# 同时在跑的 workflow 数上限；超出直接 429（不排队）
DEMO_MAX_CONCURRENT_REQUESTS=2

# 单次请求（整个 DAG，含全部 Agent 与记忆处理）的 token 预算；
# <=0 关闭。检查发生在每次 LLM 调用之前，
# 因此最多超支一次调用的量（约 2–4k token）。
DEMO_MAX_TOKENS_PER_REQUEST=50000

# 单次请求的墙钟超时（秒），超时返回 504
DEMO_REQUEST_TIMEOUT_SECONDS=180


# ------------------------------------------------------------
# 用户认证：JWT + Refresh Token
#
# JWT_SECRET_KEY 没有默认值，启动时会校验；生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# 本机 HTTP 开发用 REFRESH_TOKEN_COOKIE_SECURE=false；
# 公网 HTTPS / demo 部署改成 true。
# ------------------------------------------------------------

JWT_SECRET_KEY=replace-with-a-random-64-byte-string
JWT_ALGORITHM=HS256
JWT_ISSUER=enterprise-multi-agent
JWT_AUDIENCE=enterprise-multi-agent-api
JWT_LEEWAY_SECONDS=30

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_DELIVERY=cookie
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10

# 不配置时：dev 允许注册，demo 默认关闭。
# 需要覆盖时显式写 true / false。
# AUTH_ALLOW_REGISTRATION=true

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128


# ------------------------------------------------------------
# Langfuse（可选，不配就是关闭）
# ------------------------------------------------------------

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
