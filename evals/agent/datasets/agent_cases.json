    {
      "id": "EV-MEM-03",
      "name": "改口应更新而非新增记忆",
      "dimension": "memory",
      "description": "两句措辞高度重合，余弦相似度应越过 0.72 门槛进入 LLM 合并，判定为 UPDATE。",
      "tags": ["memory", "update"],
      "session_mode": "shared",
      "steps": [
        { "message": "以后所有回答都统一使用中文。" },
        {
          "message": "改成以后所有回答都统一使用英文。",
          "expect": {
            "require_memory_decision_in": ["UPDATE"],
            "min_steps": 2,
            "require_all_tasks_completed": true
          }
        }
      ],
      "expected_behavior": "依赖 Chroma 余弦相似度 >= 0.72。若低于阈值会退化为无 LLM 的 ADD，此时该案例失败——这是需要标定的真实边界。"
    },

    {
      "id": "EV-MEM-04",
      "name": "重复偏好不应再新增一条",
