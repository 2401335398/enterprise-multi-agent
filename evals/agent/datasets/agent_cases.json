    {
      "id": "EV-DAG-01",
      "name": "双路并行 + 依赖顺序真的被遵守",
      "dimension": "dag_runtime",
      "description": "knowledge 与 research 无依赖应并行，analysis 必须在两者都完成后才开始。用 started_at/completed_at 验证，而不只看 depends_on 字段。",
      "tags": ["dag", "parallel", "timing", "smoke"],
      "session_mode": "fresh",
      "steps": [
        { "message": "结合公司内部资料和外部市场信息，分析 KnowledgeFlow 下一季度的发展机会。" }
      ],
      "expect": {
        "required_agents": ["knowledge", "research", "analysis"],
        "min_task_count": 3,
        "require_dependency_task": true,
        "require_parallel_root_tasks": true,
        "require_concurrency": true,
        "require_task_order": true,
        "require_all_tasks_completed": true
      }
    },

    {
      "id": "EV-DAG-02",
      "name": "多源汇聚的依赖顺序",
      "dimension": "dag_runtime",
      "description": "三条上游汇聚到一个下游，验证并发真实发生且顺序未被打乱。",
      "tags": ["dag", "parallel", "timing"],
      "session_mode": "fresh",
      "steps": [
        { "message": "综合公司内部产品资料、外部市场趋势以及财务投入方向，给出 KnowledgeFlow 的优先级建议。" }
