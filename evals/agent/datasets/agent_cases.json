{
  "version": "1.0.0",
  "description": "Agent Evaluation 初始评测集。40 条端到端案例，全部走真实 POST /api/chat。期望值均来自 data/knowledge_base 的真实语料（星云科技 / InsightAI / KnowledgeFlow / NIST AI RMF 1.0）。",
  "cases": [

    {
      "id": "EV-PLN-01",
      "name": "单主题知识问题不应被过度拆分",
      "dimension": "planning",
      "description": "一个明确的单点问题，Supervisor 不应为了 Multi-Agent 而拆成多个任务。",
      "tags": ["planning", "smoke"],
      "session_mode": "fresh",
      "steps": [
        { "message": "KnowledgeFlow 3.2 是什么时候发布的？" }
      ],
      "expect": {
        "task_type_in": ["simple", "knowledge"],
        "required_agents": ["knowledge"],
        "forbidden_agents": ["research", "analysis"],
        "min_task_count": 1,
        "max_task_count": 1,
        "require_all_tasks_completed": true,
        "max_retries": 0
      }
    },

    {
      "id": "EV-PLN-02",
      "name": "纯外部调研只应使用 research",
      "dimension": "planning",
      "description": "问题只涉及外部市场，不应触发 knowledge 或 analysis。",
      "tags": ["planning", "routing"],
      "session_mode": "fresh",
      "steps": [
        { "message": "调研一下制造业企业知识管理软件的市场趋势。" }
      ],
      "expect": {
        "required_agents": ["research"],
        "forbidden_agents": ["knowledge"],
        "min_task_count": 1,
        "max_task_count": 1,
        "require_all_tasks_completed": true
      }
    },

    {
      "id": "EV-PLN-03",
      "name": "内部资料问题必须走 knowledge",
      "dimension": "planning",
      "description": "「我们公司」属于内部知识，走 research 去搜互联网是错误路由。",
      "tags": ["planning", "routing"],
      "session_mode": "fresh",
      "steps": [
        { "message": "我们公司目前有哪两个核心产品？" }
      ],
      "expect": {
        "required_agents": ["knowledge"],
        "forbidden_agents": ["research"],
        "require_all_tasks_completed": true,
        "answer_contains_any": ["InsightAI", "KnowledgeFlow"]
      }
    },

    {
      "id": "EV-PLN-04",
      "name": "内外结合问题应规划出三个 Agent",
      "dimension": "planning",
      "description": "经典复杂问题：内部知识 + 外部调研 + 综合分析。",
      "tags": ["planning", "smoke"],
      "session_mode": "fresh",
      "steps": [
        { "message": "结合公司内部资料和外部市场信息，分析 KnowledgeFlow 下一季度的发展机会，并给出优先级建议。" }
      ],
      "expect": {
        "task_type_in": ["complex"],
        "required_agents": ["knowledge", "research", "analysis"],
        "min_task_count": 3,
        "require_dependency_task": true,
        "require_parallel_root_tasks": true,
        "require_all_tasks_completed": true
      }
    },

    {
      "id": "EV-PLN-05",
      "name": "同一知识域内的复合问题不应过度拆分",
      "dimension": "planning",
      "description": "两个问题都落在企业知识库内，不应被拆成需要外部调研的多任务 DAG。",
      "tags": ["planning", "no_over_split"],
      "session_mode": "fresh",
      "steps": [
        { "message": "星云科技 2026 年的战略重点是什么，另外 KnowledgeFlow 3.2 新增了什么？" }
      ],
      "expect": {
        "required_skills": ["document_search"],
        "forbidden_agents": ["research"],
        "max_task_count": 2,
        "require_all_tasks_completed": true
      }
    },

    {
      "id": "EV-PLN-06",
      "name": "隐含比较的问题应给出合法规划",
      "dimension": "planning",
      "description": "两个产品都在同一知识库里，属比较类问题。只要求规划合法且执行完整，不强绑路由。",
      "tags": ["planning"],
      "session_mode": "fresh",
      "steps": [
        { "message": "KnowledgeFlow 和 InsightAI 哪个更适合大型企业？" }
      ],
      "expect": {
        "task_type_in": ["simple", "knowledge", "analysis", "complex"],
        "min_task_count": 1,
        "require_all_tasks_completed": true,
        "min_answer_length": 30
      }
    },

    {
      "id": "EV-PLN-07",
      "name": "单点内部问题不应升级为综合分析",
      "dimension": "planning",
      "description": "答案完全落在 company_profile.txt 里，属于单点检索，不应引入 analysis。",
      "tags": ["planning", "no_over_split"],
      "session_mode": "fresh",
      "steps": [
        { "message": "星云科技 2026 年的战略重点是什么？" }
      ],
      "expect": {
        "required_agents": ["knowledge"],
        "forbidden_agents": ["research", "analysis"],
        "max_task_count": 1,
        "answer_contains_any": ["KnowledgeFlow", "制造业"],
        "require_all_tasks_completed": true
      }
    },

    {
      "id": "EV-KNW-01",
      "name": "基础 RAG：新功能必须带引用",
      "dimension": "knowledge_grounding",
      "description": "product_update.txt 里明确写着 Manufacturing Copilot，答案必须带 [Source N] 引用。",
      "tags": ["rag", "citation", "smoke"],
      "session_mode": "fresh",
      "steps": [
        { "message": "KnowledgeFlow 3.2 新增了什么功能？" }
      ],
      "expect": {
        "required_agents": ["knowledge"],
        "required_skills": ["document_search"],
        "required_tools": ["document_search"],
        "answer_contains_any": ["Manufacturing Copilot"],
        "require_citation": true,
        "min_citations": 1,
        "max_citation_index": true,
        "require_all_tasks_completed": true,
        "max_retries": 0
      },
      "judge": {
        "enabled": true,
        "dimensions": ["groundedness", "citation", "evidence_boundary"],
        "evidence_from": "task_with_skill:document_search"
      }
    },

    {
      "id": "EV-KNW-02",
      "name": "知识库里没有的财务数字必须拒答",
      "dimension": "knowledge_grounding",
      "description": "知识库只有 313+139+250 字节的三个 txt 和 NIST PDF，没有任何营收数字。",
      "tags": ["rag", "refusal"],
      "session_mode": "fresh",
      "steps": [
        { "message": "星云科技 2025 年的营业收入和净利润分别是多少？" }
      ],
      "expect": {
        "answer_contains_any": ["证据不足", "没有找到", "未提供", "无法", "不包含", "资料中没有", "未涉及", "没有相关"],
        "answer_contains_none_of": ["亿元", "万元"],
        "require_all_tasks_completed": true
      },
      "judge": {
        "enabled": true,
        "dimensions": ["evidence_boundary", "groundedness"],
        "evidence_from": "task_with_skill:document_search"
      },
      "expected_behavior": "已知高风险。Chroma 永远返回 top-5，context 不为空，knowledge.py 的『证据不足』硬编码分支不会触发——拒答完全依赖 LLM 遵守 prompt。首轮很可能失败，这是真实发现而非评测缺陷。"
    },

    {
      "id": "EV-KNW-03",
      "name": "不存在的功能不得被编造",
      "dimension": "knowledge_grounding",
      "description": "知识库没有语音识别相关内容，答案不应凭空肯定。",
      "tags": ["rag", "refusal"],
      "session_mode": "fresh",
      "steps": [
        { "message": "KnowledgeFlow 有没有支持语音识别的功能？" }
      ],
      "expect": {
        "answer_contains_any": ["证据不足", "没有提到", "未提及", "无法确认", "没有相关", "未涉及", "不支持"],
        "require_all_tasks_completed": true
      },
      "judge": {
        "enabled": true,
        "dimensions": ["evidence_boundary", "groundedness"],
        "evidence_from": "task_with_skill:document_search"
      }
    },

    {
      "id": "EV-KNW-04",
      "name": "NIST PDF 多跳检索",
      "dimension": "knowledge_grounding",
      "description": "四个核心函数散落在 §5 AI RMF Core，是典型的英文多跳检索。",
      "tags": ["rag", "pdf", "english"],
      "session_mode": "fresh",
      "steps": [
        { "message": "What are the four core functions of the NIST AI RMF?" }
      ],
      "expect": {
        "required_agents": ["knowledge"],
        "required_tools": ["document_search"],
        "answer_contains_any": ["GOVERN", "MAP", "MEASURE", "MANAGE"],
        "require_citation": true,
        "max_citation_index": true,
        "require_all_tasks_completed": true
      },
      "judge": {
        "enabled": true,
        "dimensions": ["groundedness", "citation"],
        "evidence_from": "task_with_skill:document_search"
      }
    },

    {
      "id": "EV-KNW-05",
      "name": "跨文档检索：战略与产品更新的关联",
      "dimension": "knowledge_grounding",
      "description": "答案需要同时用到 company_profile.txt 与 product_update.txt。",
      "tags": ["rag", "multi_doc"],
      "session_mode": "fresh",
      "steps": [
        { "message": "KnowledgeFlow 3.2 的 Manufacturing Copilot 和公司 2026 年的战略重点有什么关系？" }
      ],
      "expect": {
        "required_agents": ["knowledge"],
        "answer_contains_any": ["制造业", "Manufacturing Copilot"],
        "require_citation": true,
        "min_citations": 1,
        "require_all_tasks_completed": true
      },
      "judge": {
        "enabled": true,
        "dimensions": ["groundedness", "citation", "completeness"],
        "evidence_from": "task_with_skill:document_search"
      }
    },

    {
      "id": "EV-KNW-06",
      "name": "证据充分时不得无端拒答",
      "dimension": "knowledge_grounding",
      "description": "拒答类案例的镜像：防止系统退化成『什么都不敢答』。",
      "tags": ["rag", "anti_refusal"],
      "session_mode": "fresh",
      "steps": [
        { "message": "星云科技的两个核心产品分别是什么？" }
      ],
      "expect": {
        "answer_contains_any": ["InsightAI", "KnowledgeFlow"],
        "answer_contains_none_of": ["证据不足"],
        "require_citation": true,
        "max_citation_index": true,
        "require_all_tasks_completed": true
      },
      "judge": {
        "enabled": true,
        "dimensions": ["groundedness", "citation"],
        "evidence_from": "task_with_skill:document_search"
      }
    },

    {
      "id": "EV-RES-01",
      "name": "竞品关键词触发 competitor_research",
