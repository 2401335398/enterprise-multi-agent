        "require_all_tasks_completed": true
      }
    },

    {
      "id": "EV-MEM-02",
      "name": "首次偏好应新增为语义记忆",
      "dimension": "memory",
      "description": "session 内第一条语义记忆，consolidator 无同 session 历史时应确定性 ADD（不调 LLM）。",
      "tags": ["memory", "add"],
      "session_mode": "shared",
      "steps": [
        { "message": "以后分析都要重点关注制造业相关的信息。" }
      ],
      "expect": {
