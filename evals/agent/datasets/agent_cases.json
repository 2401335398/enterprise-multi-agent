      "name": "链式依赖的顺序约束",
      "dimension": "dag_runtime",
      "description": "显式的两步链条：先查功能，再基于功能做价值分析。",
      "tags": ["dag", "chain", "timing"],
      "session_mode": "fresh",
      "steps": [
